/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; media-src 'self' blob:; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'
  Cache-Control: public, max-age=0, must-revalidate
/assets/*
  Cache-Control: public, max-age=0, must-revalidate
/play/sw.js
  Cache-Control: no-cache
/downloads/*
  Content-Disposition: attachment
  X-Robots-Tag: noindex

/play/assets/vehicles/*.glb
  Content-Type: model/gltf-binary
  Cache-Control: public, max-age=0, must-revalidate
/play/memorial.css
  Cache-Control: no-cache
/play/memorial.js
  Cache-Control: no-cache

/play/*
  Cache-Control: no-cache
